{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "brnch",
  "version": "0.1.0",
  "identifier": "app.brnch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "brnch",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Dooservice",
    "shortDescription": "Run several coding agents on one repository, each in its own gitd workspace.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
