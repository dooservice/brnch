{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "brnch",
  "version": "0.1.0",
  "identifier": "app.brnch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "brnch",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
